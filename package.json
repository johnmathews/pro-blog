{
  "name": "John-Mathews-blog",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env SOCKET=true node ./scripts/next-remote-watch.js ./data",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "dev": "next dev --turbopack",
    "build": "next build && node ./scripts/generate-sitemap && node ./scripts/searchCache",
    "aux": "node ./scripts/generate-sitemap && node ./scripts/searchCache",
    "buildSearchIndex": "node ./scripts/searchCache",
    "buildSitemap": "node ./scripts/generate-sitemap",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "next lint --fix --dir pages --dir components --dir lib --dir layouts --dir scripts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@algolia/autocomplete-js": "^1.19.0",
    "@algolia/autocomplete-plugin-recent-searches": "^1.19.0",
    "@algolia/autocomplete-preset-algolia": "^1.19.0",
    "@algolia/autocomplete-theme-classic": "^1.19.0",
    "@algolia/client-search": "^4.27.0",
    "@fontsource/inter": "^5.0.0",
    "@tabler/icons-react": "^3.41.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "algoliasearch": "^4.27.0",
    "builtin-modules": "^5.1.0",
    "dotenv": "^16.6.0",
    "esbuild": "^0.25.0",
    "fuse.js": "^7.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^1.2.0",
    "lodash": "^4.17.21",
    "mdx-bundler": "^10.1.1",
    "mousetrap": "^1.6.5",
    "next": "^15.0.0",
    "next-themes": "^0.4.0",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-jupyter-notebook-viewer": "^1.1.13",
    "react-table": "^7.8.0",
    "reading-time": "^1.5.0",
    "recharts": "^2.15.0",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-citation": "^2.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "search-insights": "^2.17.0",
    "sharp": "~0.33.5",
    "styled-jsx": "^5.1.2",
    "swr": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "unist-util-visit": "^5.0.0",
    "webpack": "^5.98.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.0.0",
    "@svgr/webpack": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^7.0.3",
    "dedent": "^1.5.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "file-loader": "^6.0.0",
    "globby": "^11.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "next-remote-watch": "^2.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
